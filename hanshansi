function askPreset(q){$('#question').value=q;ask()}function ask(){let q=$('#question').value.trim();if(!q){toast('请输入问题，或选择下方示例');return}let r=answers.find(r=>r.terms.test(q));$('#answer').innerHTML=r?`<span class="tag">本地规则匹配 · 非模型生成</span><h3>${r.title}</h3><p>${r.body}</p><hr style="border:0;border-top:1px solid var(--line)"><small>证据卡片</small><p class="mini">${r.evidence}</p><button onclick="go(1);selectRecord('${r.id}')">打开相关著录 ↗</button><p class="mini muted">局限：未检索真实馆藏全文，不能回答本地卡片以外的问题。</p>`:`<span class="tag">证据不足</span><h3>现有资料无法支持回答</h3><p>本地卡片没有覆盖该问题，暂不生成结论。请补充寺志、碑记、修缮文书或其他可核验资料。</p><small>不以常识推断冒充档案证据。</small>`}function diffText(){const a='江枫渔火对愁眠',b='江村渔火对愁眠';let diffs=[];const fmt=(str,other)=>Array.from(str).map((c,i)=>{if(c!==other[i])return '<mark>'+c+'</mark>';return c}).join('');for(let i=0;i<Math.max(a.length,b.length);i++)if(a[i]!==b[i])diffs.push(i+1);document.querySelector('.diff').innerHTML='<div><small>样例 A</small><br>'+fmt(a,b)+'</div><div><small>样例 B</small><br>'+fmt(b,a)+'</div>';$('#diffstatus').textContent='发现 '+diffs.length+' 处差异：第 '+diffs.join('、')+' 字；版本真伪须核对原碑。'}renderAI(0);

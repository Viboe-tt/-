$('#archive').innerHTML=heading(2,'从图像到档案，从档案到关联','著录不是给照片写说明，而是建立可追溯的证据关系。')+`<div class="flow"><div><em>01 / 资源辨识</em><b>区分原件与替代物</b><small>碑石、拓片、照片各自建档</small></div><div><em>02 / 元数据著录</em><b>保留来源与语境</b><small>题名、责任者、年代、载体、权限</small></div><div><em>03 / 关联组织</em><b>建立人物与事件索引</b><small>一物多证、一事多源、版本并存</small></div></div><div class="record-grid"><aside class="record-list"><label class="help" for="search">检索本页示例记录</label><input id="search" placeholder="诗碑、陈夔龙、建筑…" oninput="filterRecords(this.value)"><div id="recordbuttons"></div><p class="mini muted">DEMO 为课程演示编号。<br>本页共 5 条示例，非真实馆藏目录；不冒充馆方档号。</p><button onclick="exportRecords()">↓ 导出示例著录 JSON</button></aside><div id="recorddetail"></div></div><div class="ribbon">资源底数须有来源：据寒山寺档案部门介绍，馆藏一万余卷、涵盖 16 大门类，已建基础数据库并启动和合文献数字中心建设。上述信息转引自《AI赋能寒山寺》，尚无原始出处，待核实。</div>`;
let selectedRecord='stele';function filterRecords(q=''){let found=records.filter(r=>JSON.stringify(r).includes(q));$('#recordbuttons').innerHTML=found.length?found.map(r=>`<button class="${r.id===selectedRecord?'active':''}" onclick="selectRecord('${r.id}')">${r.title}<small>${r.code} · ${r.kind}</small></button>`).join(''):'<p>无匹配记录，请尝试“诗碑”或“建筑”。</p>'}function selectRecord(id){selectedRecord=id;let r=records.find(x=>x.id===id)||records[0];$('#recorddetail').innerHTML=`<div class="record-detail"><div class="record-image">${imageTag(r.img)}<small>${credit(r.img)}</small><p class="mini"><span class="tag">开放影像参考</span><span class="tag">非馆藏扫描原件</span></p><p class="mini muted">数字对象可检索，并不自动意味着原件可公开。原件、扫描母版与展示衍生件分别管理。</p><button onclick="go(0);teleport('${r.id}');showBuilding('${r.id}')">定位到场景 ↗</button></div><div><span class="eyebrow">${r.code}</span><h3>${r.title}</h3><table><tr><td>责任者</td><td>${r.person}</td></tr><tr><td>年代／地点</td><td>${r.time}<br>${r.place}</td></tr><tr><td>载体／层级</td><td>${r.kind}；本条为资料项级示例</td></tr><tr><td>来源与权利</td><td>${r.source}；照片依原图许可使用，原件权利另核</td></tr><tr><td>核验状态</td><td>${r.status}</td></tr><tr><td>统计／版本口径</td><td>${r.scope}</td></tr><tr><td>实体关系</td><td>${r.relation}</td></tr></table></div></div>`;filterRecords($('#search').value)}
